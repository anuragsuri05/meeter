{
  "manifest_version": 3,
  "name": "Meeter: AI Meeting Copilot",
  "short_name": "Meeter",
  "version": "1.0.0",
  "description": "Free AI copilot for every meeting: live transcript, real-time suggestions on what to say, and AI notes. Private and on-device.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open Meeter",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "tabCapture", "activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["handoff-content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+M", "mac": "Alt+M" },
      "description": "Open Meeter on this tab"
    }
  },
  "minimum_chrome_version": "116"
}
